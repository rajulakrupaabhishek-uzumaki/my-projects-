# =========================
# DATABASE SETUP
# =========================
def setup_database():

    cur = mysql.connection.cursor()

    cur.execute("""
        CREATE TABLE IF NOT EXISTS students(
            student_id INT AUTO_INCREMENT PRIMARY KEY,
            name VARCHAR(100) NOT NULL,
            email VARCHAR(100) UNIQUE NOT NULL,
            password VARCHAR(255) NOT NULL,
            branch VARCHAR(50),
            cgpa DECIMAL(3,2),
            phone VARCHAR(15)
        )
    """)

    cur.execute("""
        CREATE TABLE IF NOT EXISTS companies(
            company_id INT AUTO_INCREMENT PRIMARY KEY,
            company_name VARCHAR(100) NOT NULL,
            email VARCHAR(100),
            password VARCHAR(255),
            package VARCHAR(30)
        )
    """)

    cur.execute("""
        CREATE TABLE IF NOT EXISTS drives(
            drive_id INT AUTO_INCREMENT PRIMARY KEY,
            company_id INT,
            title VARCHAR(100),
            cgpa_required DECIMAL(3,2),
            drive_date DATE,
            FOREIGN KEY(company_id)
            REFERENCES companies(company_id)
            ON DELETE CASCADE
        )
    """)

    cur.execute("""
        CREATE TABLE IF NOT EXISTS applications(
            application_id INT AUTO_INCREMENT PRIMARY KEY,
            student_id INT,
            drive_id INT,
            status VARCHAR(30) DEFAULT 'Pending',
            FOREIGN KEY(student_id)
            REFERENCES students(student_id)
            ON DELETE CASCADE,
            FOREIGN KEY(drive_id)
            REFERENCES drives(drive_id)
            ON DELETE CASCADE,
            UNIQUE(student_id, drive_id)
        )
    """)

    # Add demo companies if table is empty
    cur.execute("SELECT COUNT(*) FROM companies")
    count = cur.fetchone()[0]

    if count == 0:

        cur.execute("""
            INSERT INTO companies
            (company_name,email,password,package)
            VALUES
            ('Infosys','infosys@company.com','company123','4.5 LPA'),
            ('TCS','tcs@company.com','company123','5 LPA'),
            ('Accenture','accenture@company.com','company123','6 LPA')
        """)

        cur.execute("""
            INSERT INTO drives
            (company_id,title,cgpa_required,drive_date)
            VALUES
            (1,'Python Developer',6.5,'2026-10-20'),
            (2,'Graduate Trainee',6.0,'2026-10-25'),
            (3,'Software Engineer',7.0,'2026-11-01')
        """)

    mysql.connection.commit()
    cur.close()


