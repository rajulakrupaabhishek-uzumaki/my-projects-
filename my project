@app.route("/apply/<int:drive_id>")
def apply(drive_id):

    if session.get("role") != "student":
        return redirect("/")

    cur = mysql.connection.cursor()

    cur.execute("""
        SELECT cgpa_required
        FROM drives
        WHERE drive_id=%s
    """, (drive_id,))

    drive = cur.fetchone()

    if not drive:

        cur.close()
        return "Drive Not Found"

    if session["cgpa"] < float(drive[0]):

        cur.close()
        return "You are not eligible for this drive."

    try:

        cur.execute("""
            INSERT INTO applications
            (student_id,drive_id,status)
            VALUES(%s,%s,'Pending')
        """, (
            session["student_id"],
            drive_id
        ))

        mysql.connection.commit()

    except:

        mysql.connection.rollback()

    cur.close()

    return redirect("/student")


