@app.route("/login", methods=["POST"])
def login():

    role = request.form["role"]
    email = request.form["email"]
    password = request.form["password"]

    # ADMIN
    if role == "admin":

        if (
            email == "admin@college.com"
            and password == "admin123"
        ):

            session.clear()
            session["role"] = "admin"

            return redirect("/admin")

        return "Invalid Admin Login"

    # COMPANY
    if role == "company":

        cur = mysql.connection.cursor()

        cur.execute("""
            SELECT company_id,
                   company_name,
                   password
            FROM companies
            WHERE email=%s
        """, (email,))

        company = cur.fetchone()

        cur.close()

        if company:

            if (
                password == company[2]
                or check_password_hash(
                    company[2],
                    password
                )
            ):

                session.clear()

                session["role"] = "company"
                session["company_id"] = company[0]
                session["company_name"] = company[1]

                return redirect("/company")

        return "Invalid Company Login"

    # STUDENT

    cur = mysql.connection.cursor()

    cur.execute("""
        SELECT student_id,
               name,
               password,
               branch,
               cgpa
        FROM students
        WHERE email=%s
    """, (email,))

    student = cur.fetchone()

    cur.close()

    if student:

        if check_password_hash(
            student[2],
            password
        ):

            session.clear()

            session["role"] = "student"
            session["student_id"] = student[0]
            session["name"] = student[1]
            session["branch"] = student[3]
            session["cgpa"] = float(student[4])

            return redirect("/student")

    return "Invalid Student Login"


