
import sqlite3
import os
from flask import Flask, render_template, request, redirect, url_for, session, flash, g
from werkzeug.security import generate_password_hash, check_password_hash
from datetime import datetime

app = Flask(__name__)
app.secret_key = 'placement_secret_2026'
DATABASE = 'placement.db'

def get_db():
    db = getattr(g, '_database', None)
    if db is None:
        db = g._database = sqlite3.connect(DATABASE)
        db.row_factory = sqlite3.Row
    return db

def init_db():
    with app.app_context():
        db = get_db()
        db.executescript("""
        CREATE TABLE IF NOT EXISTS students (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            name TEXT NOT NULL,
            roll_no TEXT UNIQUE NOT NULL,
            email TEXT UNIQUE NOT NULL,
            password TEXT NOT NULL,
            branch TEXT NOT NULL,
            cgpa REAL NOT NULL,
            skills TEXT
        );
        CREATE TABLE IF NOT EXISTS companies (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            name TEXT NOT NULL,
            role TEXT NOT NULL,
            ctc TEXT NOT NULL,
            eligibility_cgpa REAL NOT NULL,
            description TEXT,
            deadline TEXT
        );
        CREATE TABLE IF NOT EXISTS applications (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            student_id INTEGER,
            company_id INTEGER,
            status TEXT DEFAULT 'Applied',
            applied_on TEXT,
            FOREIGN KEY(student_id) REFERENCES students(id),
            FOREIGN KEY(company_id) REFERENCES companies(id),
            UNIQUE(student_id, company_id)
        );
        CREATE TABLE IF NOT EXISTS admin (
            id INTEGER PRIMARY KEY,
            username TEXT UNIQUE,
            password TEXT
        );
        """)
        # default admin
        cur = db.execute("SELECT * FROM admin WHERE username='admin'")
        if not cur.fetchone():
            db.execute("INSERT INTO admin (username, password) VALUES (?,?)", ('admin', generate_password_hash('admin123')))
        db.commit()

@app.teardown_appcontext
def close_connection(exception):
    db = getattr(g, '_database', None)
    if db is not None:
        db.close()

@app.route('/')
def index():
    db = get_db()
    companies = db.execute("SELECT * FROM companies ORDER BY id DESC").fetchall()
    stats = {
        'students': db.execute("SELECT COUNT(*) FROM students").fetchone()[0],
        'companies': db.execute("SELECT COUNT(*) FROM companies").fetchone()[0],
        'applications': db.execute("SELECT COUNT(*) FROM applications").fetchone()[0],
        'placed': db.execute("SELECT COUNT(*) FROM applications WHERE status='Placed'").fetchone()[0]
    }
    return render_template('index.html', companies=companies, stats=stats)

# Student Auth
@app.route('/register', methods=['GET','POST'])
def register():
    if request.method == 'POST':
        name = request.form['name']
        roll = request.form['roll_no']
        email = request.form['email']
        branch = request.form['branch']
        cgpa = float(request.form['cgpa'])
        skills = request.form['skills']
        password = generate_password_hash(request.form['password'])
        db = get_db()
        try:
            db.execute("INSERT INTO students (name, roll_no, email, password, branch, cgpa, skills) VALUES (?,?,?,?,?,?,?)",
                       (name, roll, email, password, branch, cgpa, skills))
            db.commit()
            flash('Registration successful! Please login.', 'success')
            return redirect(url_for('login'))
        except sqlite3.IntegrityError:
            flash('Roll No or Email already exists!', 'danger')
    return render_template('register.html')

@app.route('/login', methods=['GET','POST'])
def login():
    if request.method == 'POST':
        email = request.form['email']
        password = request.form['password']
        db = get_db()
        user = db.execute("SELECT * FROM students WHERE email=?", (email,)).fetchone()
        if user and check_password_hash(user['password'], password):
            session['student_id'] = user['id']
            session['student_name'] = user['name']
            return redirect(url_for('dashboard'))
        else:
            flash('Invalid credentials', 'danger')
    return render_template('login.html')

@app.route('/dashboard')
def dashboard():
    if 'student_id' not in session:
        return redirect(url_for('login'))
    db = get_db()
    student = db.execute("SELECT * FROM students WHERE id=?", (session['student_id'],)).fetchone()
    # eligible companies
    companies = db.execute("SELECT * FROM companies WHERE eligibility_cgpa <= ?", (student['cgpa'],)).fetchall()
    my_apps = db.execute("""
        SELECT a.*, c.name as company_name, c.role, c.ctc FROM applications a
        JOIN companies c ON a.company_id = c.id
        WHERE a.student_id = ?
    """, (session['student_id'],)).fetchall()
    return render_template('dashboard.html', student=student, companies=companies, my_apps=my_apps)

@app.route('/apply/<int:company_id>')
def apply(company_id):
    if 'student_id' not in session:
        return redirect(url_for('login'))
    db = get_db()
    try:
        db.execute("INSERT INTO applications (student_id, company_id, applied_on) VALUES (?,?,?)",
                   (session['student_id'], company_id, datetime.now().strftime("%Y-%m-%d %H:%M")))
        db.commit()
        flash('Applied successfully!', 'success')
    except sqlite3.IntegrityError:
        flash('Already applied to this company!', 'warning')
    return redirect(url_for('dashboard'))

@app.route('/logout')
def logout():
    session.clear()
    return redirect(url_for('index'))

# Admin Routes
@app.route('/admin', methods=['GET','POST'])
def admin_login():
    if request.method == 'POST':
        username = request.form['username']
        password = request.form['password']
        db = get_db()
        admin = db.execute("SELECT * FROM admin WHERE username=?", (username,)).fetchone()
        if admin and check_password_hash(admin['password'], password):
            session['admin'] = True
            return redirect(url_for('admin_dashboard'))
        flash('Invalid admin credentials', 'danger')
    return render_template('admin_login.html')

@app.route('/admin/dashboard')
def admin_dashboard():
    if not session.get('admin'):
        return redirect(url_for('admin_login'))
    db = get_db()
    students = db.execute("SELECT * FROM students").fetchall()
    companies = db.execute("SELECT * FROM companies").fetchall()
    applications = db.execute("""
        SELECT a.id, a.status, s.name as student_name, s.roll_no, s.branch, s.cgpa, c.name as company_name, c.role
        FROM applications a
        JOIN students s ON a.student_id = s.id
        JOIN companies c ON a.company_id = c.id
        ORDER BY a.id DESC
    """).fetchall()
    return render_template('admin_dashboard.html', students=students, companies=companies, applications=applications)

@app.route('/admin/add_company', methods=['POST'])
def add_company():
    if not session.get('admin'):
        return redirect(url_for('admin_login'))
    db = get_db()
    db.execute("INSERT INTO companies (name, role, ctc, eligibility_cgpa, description, deadline) VALUES (?,?,?,?,?,?)",
               (request.form['name'], request.form['role'], request.form['ctc'], float(request.form['eligibility']), request.form['description'], request.form['deadline']))
    db.commit()
    flash('Company added!', 'success')
    return redirect(url_for('admin_dashboard'))

@app.route('/admin/update_status/<int:app_id>/<status>')
def update_status(app_id, status):
    if not session.get('admin'):
        return redirect(url_for('admin_login'))
    db = get_db()
    db.execute("UPDATE applications SET status=? WHERE id=?", (status, app_id))
    db.commit()
    return redirect(url_for('admin_dashboard'))

@app.route('/admin/delete_company/<int:id>')
def delete_company(id):
    if not session.get('admin'):
        return redirect(url_for('admin_login'))
    db = get_db()
    db.execute("DELETE FROM companies WHERE id=?", (id,))
    db.execute("DELETE FROM applications WHERE company_id=?", (id,))
    db.commit()
    return redirect(url_for('admin_dashboard'))

if __name__ == '__main__':
    if not os.path.exists(DATABASE):
        init_db()
    else:
        init_db()
    app.run(debug=True, host='0.0.0.0', port=5000)
